# ════════════════════════════════════════════════════════════════
# Stock Fit Lab 環境變數範本：複製為 .env.local（本機）或填入 Vercel Project Settings
# 所有金鑰只存環境變數，不寫進程式碼。未設定的項目會自動降級（見 README「降級行為」）。
# ════════════════════════════════════════════════════════════════

# ── 網站 ──
NEXT_PUBLIC_SITE_URL=http://localhost:3000          # 通知訊息中的直連 URL
DEFAULT_USER_ID=demo                                 # 尚未接登入系統時的預設使用者（自選股/對話歸屬）

# ── 儲存 ──
DATABASE_URL=                                        # Postgres（Vercel Postgres / Supabase / Neon）；未設定 → 記憶體 + .data/store.json
KV_REST_API_URL=                                     # Vercel KV / Upstash REST（行情快取）；未設定 → 記憶體 LRU
KV_REST_API_TOKEN=

# ── 資料源（免費替代源為預設）──
FINMIND_TOKEN=                                       # 選填；不填使用 FinMind 免費額度（台股主力來源）
ALPHAVANTAGE_API_KEY=                                # 選填；美股備援
POLYGON_API_KEY=                                     # 選填；美股備援 + 盤中細粒度
FINNHUB_API_KEY=                                     # 選填；美股報價、財報日、內部人交易

# ── 數值微服務（選填）──
PY_SERVICE_URL=                                      # 例如 https://sfl-py.fly.dev；未設定 → 全部使用 TypeScript 實作

# ── AI 分析助理 ──
LLM_PROVIDER=anthropic
LLM_MODEL=claude-opus-5-5
LLM_EFFORT=medium                                    # low | medium | high | xhigh | max
ANTHROPIC_API_KEY=
LLM_DAILY_REQUEST_LIMIT=200
LLM_DAILY_COST_LIMIT_USD=5
LLM_FALLBACKS=on                                     # off 可關閉伺服器端拒答備援

# ── 排程與追蹤 ──
CRON_SECRET=                                         # Vercel Cron 會自動帶 Authorization: Bearer <CRON_SECRET>
TRACK_SYMBOLS=2330.TW,0050.TW,2454.TW,AAPL,NVDA,MSFT # 除自選股外，排程固定追蹤的代號

# ── 通知 ──
DISCORD_WEBHOOK_URL=
LINE_CHANNEL_ACCESS_TOKEN=                           # LINE Notify 已於 2025-03-31 停止服務，改用 Messaging API
LINE_TO=                                             # 推播對象 userId / groupId
RESEND_API_KEY=
ALERT_EMAIL_TO=
ALERT_EMAIL_FROM=
ADMIN_ALERT_WEBHOOK=                                 # 選填；健康監控（連續失敗兩次）通知管理者用的 Discord webhook，未設定則用 DISCORD_WEBHOOK_URL
